# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# G2.17 — resultados locais do piloto do Mentor IA (respostas para avaliação humana)
/pilot-runs/

# G2.20 — saídas dos testes E2E (screenshots, traces, relatório)
/e2e/.results/
/e2e/.report/
/e2e/.auth/
/playwright-report/
/test-results/
